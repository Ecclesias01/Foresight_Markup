RewriteEngine On

# ==========================================================
# DO NOT REDIRECT POST/AJAX/PHP PROCESSING FILES
# ==========================================================

RewriteRule ^process-contact\.php$ - [L]
RewriteRule ^submit\.php$ - [L]


# ==========================================================
# REMOVE .php FROM NORMAL PAGE URLs
# ==========================================================

RewriteCond %{THE_REQUEST} \s/+(.+)\.php(?:[\s?]|$) [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L]


# ==========================================================
# REMOVE .html FROM NORMAL PAGE URLs
# ==========================================================

RewriteCond %{THE_REQUEST} \s/+(.+)\.html(?:[\s?]|$) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]


# ==========================================================
# CLEAN URL → .php
# Example: /admin → /admin.php
# ==========================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]


# ==========================================================
# CLEAN URL → .html
# Example: /about → /about.html
# ==========================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
